# .env.example
# 저장소 루트에 .env 파일을 만들고 아래 키에 실제 값을 채워 넣으세요. .env는 git에 커밋되지 않습니다.

# MLLM(Claude) API 연동에 필요합니다. https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=your_api_key_here

# backend/mllm/model_comparison.py에서 Qwen2.5-VL, Llama Vision(Together 호스팅) 비교용으로 사용합니다.
# https://api.together.ai 에서 발급.
TOGETHER_API_KEY=your_api_key_here

# backend/mllm/model_comparison.py에서 Gemini 비교용으로 사용합니다.
# https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=your_api_key_here

# backend/api/tts.py에서 카탈로그 밖 동적 문장(즉시 요약·사진 설명)의 앱 보이스 프리셋
# (아리아/올리버) 합성에 사용합니다. SKT A.X 발급 앱 키.
SKT_TTS_APP_KEY=your_app_key_here

# 배포 시 선택적으로 켜는 공용 API 토큰. 설정하면 Android 빌드의
# -PSNAPSIGHT_API_TOKEN 값과 같아야 합니다. APK 내 값은 강한 사용자 인증 수단은 아닙니다.
SNAPSIGHT_API_TOKEN=

# 촬영 이미지/결과 보존 및 정리. 0은 정리 비활성화이므로 개발 외에는 권장하지 않습니다.
SNAPSIGHT_CAPTURE_TTL_SECONDS=86400
SNAPSIGHT_CAPTURE_CLEANUP_INTERVAL_SECONDS=900
SNAPSIGHT_CAPTURE_CLEANUP_BATCH_SIZE=64

# 단일 프로세스 분당 요청 제한. 0은 비활성화입니다.
SNAPSIGHT_RATE_LIMIT_PER_MINUTE=0

# 최신 Android는 canonical UUID를 사용합니다. 구형 s_* 세션을 더 받지 않을 배포에서 활성화합니다.
SNAPSIGHT_REQUIRE_UUID_SESSION_IDS=1
