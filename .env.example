# .env.example
# 저장소 루트에 .env 파일을 만들고 아래 키에 실제 값을 채워 넣으세요. .env는 git에 커밋되지 않습니다.

# MLLM(Claude) API 연동에 필요합니다. https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=your_api_key_here

# backend/mllm/model_comparison.py에서 Qwen2.5-VL, Llama Vision(Together 호스팅) 비교용으로 사용합니다.
# https://api.together.ai 에서 발급.
TOGETHER_API_KEY=your_api_key_here

# backend/mllm/model_comparison.py에서 Gemini 비교용으로 사용합니다.
# https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=your_api_key_here
